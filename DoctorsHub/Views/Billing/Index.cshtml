
@model PagedResult<BillDto>

@{
    ViewData["Title"] = "Billing";

    var currentSearch = Context.Request.Query["searchString"].ToString();
    var currentPaymentStatus = Context.Request.Query["paymentStatus"].ToString();
    var currentSortBy = Context.Request.Query["sortBy"].ToString();
    var currentSortOrder = Context.Request.Query["sortOrder"].ToString();

    // Determine next sorting order for each column
    var nextBillIdOrder =
        currentSortBy == "BillId" && currentSortOrder == "asc"
            ? "desc"
            : "asc";

    var nextPatientNameOrder =
        currentSortBy == "PatientName" && currentSortOrder == "asc"
            ? "desc"
            : "asc";

    var nextDoctorNameOrder =
        currentSortBy == "DoctorName" && currentSortOrder == "asc"
            ? "desc"
            : "asc";

    var nextConsultationFeeOrder =
        currentSortBy == "ConsultationFee" && currentSortOrder == "asc"
            ? "desc"
            : "asc";

    var nextAdditionalChargesOrder =
        currentSortBy == "AdditionalCharges" && currentSortOrder == "asc"
            ? "desc"
            : "asc";

    var nextDiscountOrder =
        currentSortBy == "Discount" && currentSortOrder == "asc"
            ? "desc"
            : "asc";

    var nextTotalAmountOrder =
        currentSortBy == "TotalAmount" && currentSortOrder == "asc"
            ? "desc"
            : "asc";

    var nextPaymentStatusOrder =
        currentSortBy == "PaymentStatus" && currentSortOrder == "asc"
            ? "desc"
            : "asc";

    var nextBillDateOrder =
        currentSortBy == "BillDate" && currentSortOrder == "asc"
            ? "desc"
            : "asc";
}

<div class="page-container">

    <!-- Header -->
    <div class="header">

        <h2>Billing</h2>

    </div>


    <!-- Search + Payment Filter -->
    <form method="get">

        <div class="table-toolbar mb-3">

            <div class="search-box">

                <i class="bi bi-search"></i>

                <!-- Search -->
                <input type="text"
                       id="billingSearch"
                       name="searchString"
                       value="@currentSearch"
                       placeholder="Search bills..."
                       autocomplete="off" />


                <!-- Payment Status -->
                <select name="paymentStatus"
                        id="paymentStatus">

                    <option value=""
                            selected="@(string.IsNullOrEmpty(currentPaymentStatus))">
                        All Payment Status
                    </option>

                    <option value="Paid"
                            selected="@(currentPaymentStatus == "Paid")">
                        Paid
                    </option>

                    <option value="Pending"
                            selected="@(currentPaymentStatus == "Pending")">
                        Pending
                    </option>

                    <option value="Cancelled"
                            selected="@(currentPaymentStatus == "Cancelled")">
                        Cancelled
                    </option>

                </select>


                <!-- Search Button -->
                <button type="submit"
                        class="btn btn-primary">
                    Search
                </button>


                <!-- Reset -->
                <a asp-action="Index"
                   class="btn-cancel">
                    Reset
                </a>

            </div>

        </div>

    </form>


    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert-success">
            @TempData["Success"]
        </div>
    }


    <!-- Billing Table -->
    <div class="table-container">

        <table class="table">

            <thead>

                <tr>

                    <!-- Bill ID -->
                    <th>
                        <a asp-action="Index"
                           asp-route-searchString="@currentSearch"
                           asp-route-paymentStatus="@currentPaymentStatus"
                           asp-route-sortBy="BillId"
                           asp-route-sortOrder="@nextBillIdOrder">

                            Bill ID

                            @if (currentSortBy == "BillId")
                            {
                                <span>
                                    @(currentSortOrder == "asc" ? "↑" : "↓")
                                </span>
                            }

                        </a>
                    </th>


                    <!-- Patient -->
                    <th>
                        <a asp-action="Index"
                           asp-route-searchString="@currentSearch"
                           asp-route-paymentStatus="@currentPaymentStatus"
                           asp-route-sortBy="PatientName"
                           asp-route-sortOrder="@nextPatientNameOrder">

                            Patient

                            @if (currentSortBy == "PatientName")
                            {
                                <span>
                                    @(currentSortOrder == "asc" ? "↑" : "↓")
                                </span>
                            }

                        </a>
                    </th>


                    <!-- Doctor -->
                    <th>
                        <a asp-action="Index"
                           asp-route-searchString="@currentSearch"
                           asp-route-paymentStatus="@currentPaymentStatus"
                           asp-route-sortBy="DoctorName"
                           asp-route-sortOrder="@nextDoctorNameOrder">

                            Doctor

                            @if (currentSortBy == "DoctorName")
                            {
                                <span>
                                    @(currentSortOrder == "asc" ? "↑" : "↓")
                                </span>
                            }

                        </a>
                    </th>


                    <!-- Consultation Fee -->
                    <th>
                        <a asp-action="Index"
                           asp-route-searchString="@currentSearch"
                           asp-route-paymentStatus="@currentPaymentStatus"
                           asp-route-sortBy="ConsultationFee"
                           asp-route-sortOrder="@nextConsultationFeeOrder">

                            Consultation Fee

                            @if (currentSortBy == "ConsultationFee")
                            {
                                <span>
                                    @(currentSortOrder == "asc" ? "↑" : "↓")
                                </span>
                            }

                        </a>
                    </th>


                    <!-- Additional Charges -->
                    <th>
                        <a asp-action="Index"
                           asp-route-searchString="@currentSearch"
                           asp-route-paymentStatus="@currentPaymentStatus"
                           asp-route-sortBy="AdditionalCharges"
                           asp-route-sortOrder="@nextAdditionalChargesOrder">

                            Additional Charges

                            @if (currentSortBy == "AdditionalCharges")
                            {
                                <span>
                                    @(currentSortOrder == "asc" ? "↑" : "↓")
                                </span>
                            }

                        </a>
                    </th>


                    <!-- Discount -->
                    <th>
                        <a asp-action="Index"
                           asp-route-searchString="@currentSearch"
                           asp-route-paymentStatus="@currentPaymentStatus"
                           asp-route-sortBy="Discount"
                           asp-route-sortOrder="@nextDiscountOrder">

                            Discount

                            @if (currentSortBy == "Discount")
                            {
                                <span>
                                    @(currentSortOrder == "asc" ? "↑" : "↓")
                                </span>
                            }

                        </a>
                    </th>


                    <!-- Total Amount -->
                    <th>
                        <a asp-action="Index"
                           asp-route-searchString="@currentSearch"
                           asp-route-paymentStatus="@currentPaymentStatus"
                           asp-route-sortBy="TotalAmount"
                           asp-route-sortOrder="@nextTotalAmountOrder">

                            Total Amount

                            @if (currentSortBy == "TotalAmount")
                            {
                                <span>
                                    @(currentSortOrder == "asc" ? "↑" : "↓")
                                </span>
                            }

                        </a>
                    </th>


                    <!-- Payment Status -->
                    <th>
                        <a asp-action="Index"
                           asp-route-searchString="@currentSearch"
                           asp-route-paymentStatus="@currentPaymentStatus"
                           asp-route-sortBy="PaymentStatus"
                           asp-route-sortOrder="@nextPaymentStatusOrder">

                            Payment Status

                            @if (currentSortBy == "PaymentStatus")
                            {
                                <span>
                                    @(currentSortOrder == "asc" ? "↑" : "↓")
                                </span>
                            }

                        </a>
                    </th>


                    <!-- Bill Date -->
                    <th>
                        <a asp-action="Index"
                           asp-route-searchString="@currentSearch"
                           asp-route-paymentStatus="@currentPaymentStatus"
                           asp-route-sortBy="BillDate"
                           asp-route-sortOrder="@nextBillDateOrder">

                            Bill Date

                            @if (currentSortBy == "BillDate")
                            {
                                <span>
                                    @(currentSortOrder == "asc" ? "↑" : "↓")
                                </span>
                            }

                        </a>
                    </th>


                    <!-- Info -->
                    <th>
                        Info
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (Model.Items != null && Model.Items.Any())
                {
                    foreach (var bill in Model.Items)
                    {
                        <tr>

                            <td>
                                @bill.Id
                            </td>

                            <td>
                                @bill.PatientName
                            </td>

                            <td>
                                @bill.DoctorName
                            </td>

                            <td>
                                ₹@bill.ConsultationFee.ToString("N2")
                            </td>

                            <td>
                                ₹@bill.AdditionalCharges.ToString("N2")
                            </td>

                            <td>
                                ₹@bill.Discount.ToString("N2")
                            </td>

                            <td>
                                <strong>
                                    ₹@bill.TotalAmount.ToString("N2")
                                </strong>
                            </td>

                            <td>
                                @bill.PaymentStatus
                            </td>

                            <td>
                                @bill.BillDate.ToString("dd MMM yyyy")
                            </td>

                            <td>

                                <a asp-action="Details"
                                   asp-route-id="@bill.Id"
                                   class="btn-info">
                                    Details
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@bill.Id"
                                   class="btn-edit">
                                    Edit
                                </a>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="10"
                            class="text-center">

                            No bills found.

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>


    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="pagination">

            @if (Model.PageNumber > 1)
            {
                <a asp-action="Index"
                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                   asp-route-pageSize="@Model.PageSize"
                   asp-route-searchString="@currentSearch"
                   asp-route-paymentStatus="@currentPaymentStatus"
                   asp-route-sortBy="@currentSortBy"
                   asp-route-sortOrder="@currentSortOrder"
                   class="page-btn">

                    Prev

                </a>
            }


            <span class="page-info">

                Page @Model.PageNumber of @Model.TotalPages

            </span>


            @if (Model.PageNumber < Model.TotalPages)
            {
                <a asp-action="Index"
                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                   asp-route-pageSize="@Model.PageSize"
                   asp-route-searchString="@currentSearch"
                   asp-route-paymentStatus="@currentPaymentStatus"
                   asp-route-sortBy="@currentSortBy"
                   asp-route-sortOrder="@currentSortOrder"
                   class="page-btn">

                    Next

                </a>
            }

        </div>
    }

</div>