@{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();

    var role = User.FindFirst(ClaimTypes.Role)?.Value;
    var email = User.FindFirst(ClaimTypes.Email)?.Value;
    

}

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - DoctorHub</title>

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

</head>

<body>

    <div class="app-layout">

        <!-- ================= Sidebar ================= -->

        <aside class="sidebar collapsed" id="sidebar">

            <!-- Brand -->

            <div class="sidebar-brand">
                <div class="sidebar-brand-logo">
                    <i class="bi bi-heart-pulse-fill"></i>
                </div>

                <div class="sidebar-brand-text">
                    <h2>DoctorHub</h2>
                    <span>Enterprise Healthcare</span>
                </div>
            </div>

            <!-- Navigation -->

            <nav class="sidebar-nav">

                <ul>

                    <li>

                        <a asp-controller="DashBoard"
                           asp-action="Index"
                           class="@(currentController == "DashBoard" ? "active" : "")">

                            <i class="bi bi-grid"></i>

                            <span>Dashboard</span>

                        </a>

                    </li>

                    
                    <li>

                        <a asp-controller="Doctor"
                            class="@(currentController == "Doctor" ? "active" : "")">

                            <i class="bi bi-person-badge"></i>

                            <span>Doctors</span>

                        </a>

                    </li>
                       

                   

                    <li>

                        <a asp-controller="Patients"
                        asp-action="Index"
                           class="@(currentController == "Patients" ? "active" : "")">

                            <i class="bi bi-people"></i>

                            <span>Patients</span>

                        </a>

                    </li>

                    <li>

                        <a asp-controller="Appointments" 
                        asp-action="Index"
                           class="@(currentController == "Appointments" ? "active" : "")">

                            <i class="bi bi-calendar-check"></i>

                            <span>Appointments</span>

                        </a>

                    </li>

                       
                    <li>

                        <a asp-controller="BusinessInsights"
                            asp-action="Index"
                            class="@(currentController == "BusinessInsights" ? "active" : "")">

                            <i class="bi bi-graph-up-arrow"></i>

                            <span>Business Insights</span>

                        </a>

                    </li>
                        

                    <li>

                        <a href="#"
                           class="@(currentController == "Departments" ? "active" : "")">

                            <i class="bi bi-building"></i>

                            <span>Departments</span>

                        </a>

                    </li>

                    <li>

                        <a 
                            asp-action="Index"
                            asp-controller="Billing">

                            <i class="bi bi-credit-card"></i>

                            <span>Billing</span>

                        </a>

                    </li>

                    <li>

                        <a 
                            asp-action="Index" 
                            asp-controller="Reports">

                            <i class="bi bi-bar-chart-line"></i>

                            <span>Reports</span>

                        </a>

                    </li>

                </ul>

            </nav>

            <!-- Sidebar Footer -->

            <div class="sidebar-footer">

                <a href="#">

                    <i class="bi bi-gear"></i>

                    <span>Settings</span>

                </a>

            </div>

        </aside>

        <!-- ================= Main ================= -->

        <main class="main-content">

            <!-- ================= Topbar ================= -->

            <header class="topbar">

                <div class="topbar-left">

                    <button id="sidebarToggle" class="menu-btn">

                        <i class="bi bi-list"></i>

                    </button>

                    <div class="page-title">

                        <h3>@ViewData["Title"]</h3>

                        <small>DoctorHub Enterprise Healthcare</small>

                    </div>

                </div>

                <div class="topbar-right">

                    <!-- Search -->

                    <div class="search-box">

                        <i class="bi bi-search"></i>

                        <input type="text"
                               placeholder="Search..." />

                    </div>

                    <!-- Notification -->
                    <div class="dropdown">
                        <button class="btn btn-link text-dark text-decoration-none position-relative"
                                type="button"
                                id="notificationBell"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">

                            <i class="bi bi-bell fs-5"></i>

                            <!-- Unread count -->
                            <span id="notificationBadge"
                                  class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none">
                                
                            </span>
                        </button>

                        <!-- Notification Popup -->
                        <div class="dropdown-menu dropdown-menu-end shadow notification-dropdown"
                             aria-labelledby="notificationBell"
                             style="width: 360px;">

                            <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                                <strong>Notifications</strong>

                                <button type="button"
                                        id="markAllAsRead"
                                        class="btn btn-sm notification-action">
                                    Mark all as read
                                </button>
                            </div>

                            <div id="notificationList">
                                <div class="text-center text-muted py-4">
                                    No notifications
                                </div>
                            </div>

                            <div class="border-top text-center">
                                <a asp-controller="Notification"
                                   asp-action="Index"
                                   class="btn btn-sm notification-action">
                                    View all notifications
                                </a>
                            </div>

                        </div>
                    </div>

                    <!-- User -->

                    <div class="user-profile-dropdown">

                        <button type="button" class="user-profile" id="userProfileBtn">

                            <div class="avatar">
                                @email?.Substring(0, 1).ToUpper()
                            </div>

                            <div class="user-info">
                                <strong>@email</strong>
                                
                                @if(role == "Admin")
                                {
                                    <small>System Administrator</small>
                                }

                                @if (role == "Doctor")
                                {
                                    <small>Doctor</small>
                                }

                                @if (role == "Receptionist")
                                {
                                    <small>Receptionist</small>
                                }

                            </div>

                            <i class="bi bi-chevron-up"></i>

                        </button>

                        <div class="user-dropdown-menu" id="userDropdownMenu">

                            <a href="#">
                                <i class="bi bi-person"></i>
                                Profile
                            </a>

                            <a href="#">
                                <i class="bi bi-gear"></i>
                                Settings
                            </a>

                            <hr />

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post">

                                <button type="submit">
                                    <i class="bi bi-box-arrow-right"></i>
                                    Logout
                                </button>

                            </form>

                        </div>

                    </div>

               
            </header>

            <!-- ================= Page Content ================= -->

            <section class="page-content">

                @RenderBody()

            </section>

        </main>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>

        // const sidebar = document.getElementById("sidebar");
        // const btn = document.getElementById("sidebarToggle");

        // btn.addEventListener("click", () => {

        // sidebar.classList.toggle("collapsed");

        // localStorage.setItem(
        // "sidebar",
        // sidebar.classList.contains("collapsed")
        // );

        // });

        // if(localStorage.getItem("sidebar") === "true"){

        // sidebar.classList.add("collapsed");

        // }

    </script>

    <script src="~/js/layout.js"></script>
    <script src="~/js/notifications.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    

</body>
</html>