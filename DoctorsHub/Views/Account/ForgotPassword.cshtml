@model ForgotPasswordDto

@{
    Layout = null;
    ViewData["Title"] = "Forgot Password";
}

<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


<div class="auth-page">

    <div class="auth-container">

        <!-- ===========================
             Left Branding Section
        ============================ -->
        <div class="auth-brand-section">

            <div class="auth-brand">

                <div class="auth-brand-logo">

                    <i class="bi bi-heart-pulse-fill"></i>

                </div>

                <div class="auth-brand-text">

                    <h1>
                        DoctorsHub
                    </h1>

                    <p>
                        MultiSpeciality Hospital Management System
                    </p>

                </div>

            </div>


            <ul class="auth-feature-list">

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Doctor & Patient Management
                </li>

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Appointment Scheduling
                </li>

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Easy Appointment Booking
                </li>

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Business Analytics
                </li>

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Trusted Microsoft Identity Security
                </li>

            </ul>

        </div>


        <!-- ===========================
             Forgot Password Section
        ============================ -->
        <div class="auth-form-section">

            <div class="auth-form-wrapper">

                <h2>
                    Forgot Password?
                </h2>

                <p class="auth-form-subtitle">
                    Enter your personal email address and we'll
                    send you a verification code.
                </p>


                <form asp-action="ForgotPassword" method="post">

                    <!-- Validation Summary -->
                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    <!-- Personal Email -->
                    <div class="auth-form-group">

                        <label asp-for="PersonalEmail"
                               class="auth-form-label">
                        </label>

                        <input asp-for="PersonalEmail"
                               class="auth-form-control"
                               placeholder="Enter your personal email"
                               autocomplete="email" />

                        <span asp-validation-for="PersonalEmail"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Send OTP -->
                    <button type="submit"
                            class="auth-btn">

                        Send OTP

                    </button>

                </form>


                <!-- Back to Login -->
                <div class="auth-footer">

                    Remember your password?

                    <a asp-action="Login">
                        Back to Sign In
                    </a>

                </div>


            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
```
