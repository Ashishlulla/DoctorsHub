@model VerifyForgotPasswordOtpDto

@{
    Layout = null;
    ViewData["Title"] = "Verify Password Reset";
}

<link rel="stylesheet"
      href="~/css/auth.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<div class="auth-page">

    <div class="auth-container">

        <!-- ===========================
             Left Branding Section
        ============================ -->

        <div class="auth-brand-section">

            <div class="auth-brand">

                <div class="auth-brand-logo">
                    <i class="bi bi-heart-pulse-fill"></i>
                </div>

                <div class="auth-brand-text">

                    <h1>
                        DoctorsHub
                    </h1>

                    <p>
                        MultiSpeciality Hospital Management System
                    </p>

                </div>

            </div>

            <ul class="auth-feature-list">

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Doctor & Patient Management
                </li>

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Appointment Scheduling
                </li>

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Easy Appointment Booking
                </li>

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Business Analytics
                </li>

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Trusted Microsoft Identity Security
                </li>

            </ul>

        </div>


        <!-- ===========================
             OTP Verification Section
        ============================ -->

        <div class="auth-form-section">

            <div class="auth-form-wrapper">

                <div class="text-center mb-4">

                    <div class="auth-brand-logo mx-auto mb-3">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>

                    <h2>
                        Verify Your Identity
                    </h2>

                    <p class="auth-form-subtitle">
                        Enter the verification code sent to your personal email.
                    </p>

                </div>


                <form asp-action="VerifyForgotPasswordOtp"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    <!-- Hidden User Id -->

                    <input asp-for="UserId"
                           type="hidden" />


                    <!-- OTP -->

                    <div class="auth-form-group">

                        <label asp-for="Otp"
                               class="auth-form-label">
                            Verification Code
                        </label>

                        <input asp-for="Otp"
                               class="auth-form-control"
                               placeholder="Enter 6-digit OTP"
                               maxlength="6"
                               autocomplete="one-time-code"
                               inputmode="numeric" />

                        <span asp-validation-for="Otp"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Verify Button -->

                    <button type="submit"
                            class="auth-btn">

                        <i class="bi bi-shield-check me-2"></i>

                        Verify OTP

                    </button>

                </form>


                <!-- Back -->

                <div class="auth-footer">

                    <a asp-action="ForgotPassword">

                        <i class="bi bi-arrow-left me-1"></i>

                        Back to Forgot Password

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}