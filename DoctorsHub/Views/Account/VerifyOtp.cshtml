@{
    Layout = null;
    ViewData["Title"] = "Verify OTP";
}

<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


<div class="auth-page">

    <div class="auth-container">

        <!-- ===========================
             Left Branding Section
        ============================ -->

        <div class="auth-brand-section">

            <div class="auth-brand">

                <div class="auth-brand-logo">

                    <i class="bi bi-heart-pulse-fill"></i>

                </div>

                <div class="auth-brand-text">

                    <h1>
                        DoctorsHub
                    </h1>

                    <p>
                        MultiSpeciality Hospital Management System
                    </p>

                </div>

            </div>


            <ul class="auth-feature-list">

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Doctor & Patient Management
                </li>

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Appointment Scheduling
                </li>

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Easy Appointment Booking
                </li>

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Business Analytics
                </li>

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Trusted Microsoft Identity Security
                </li>

            </ul>

        </div>


        <!-- ===========================
             OTP Verification Section
        ============================ -->

        <div class="auth-form-section">

            <div class="auth-form-wrapper">

                <h2>
                    Verify Your Login
                </h2>

                <p class="auth-form-subtitle">
                    Enter the verification code sent to your personal email.
                </p>


                @if (ViewBag.OtpError != null)
                {
                    <div class="text-danger mb-3">
                        @ViewBag.OtpError
                    </div>
                }


                <form asp-action="VerifyOtp" method="post">

                    <!-- User Id -->

                    <input type="hidden"
                           name="userId"
                           value="@ViewBag.UserId" />


                    <!-- OTP -->

                    <div class="auth-form-group">

                        <label class="auth-form-label">
                            Verification Code
                        </label>

                        <input type="text"
                               name="otp"
                               class="auth-form-control"
                               placeholder="Enter 6-digit OTP"
                               maxlength="6"
                               minlength="6"
                               inputmode="numeric"
                               autocomplete="one-time-code"
                               required />

                    </div>


                    <!-- Verify Button -->

                    <button type="submit"
                            class="auth-btn">

                        Verify OTP

                    </button>

                </form>


                <div class="auth-footer">

                    <p>
                        OTP is valid for
                        <strong>90 seconds</strong>.
                    </p>

                    <p>
                        Please do not share this code with anyone.
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>