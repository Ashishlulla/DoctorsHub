@model PagedResult<AppointmentDto>

@{
    ViewData["Title"] = "Appointments";

    var currentSearch = Context.Request.Query["searchString"].ToString();
    var currentAppointmentStatus = Context.Request.Query["appointmentStatus"].ToString();
    var currentSortBy = Context.Request.Query["sortBy"].ToString();
    var currentSortOrder = Context.Request.Query["sortOrder"].ToString();

    // Determine next sorting order for each column
    var nextAppointmentDateOrder =
        currentSortBy == "AppointmentDate" && currentSortOrder == "asc"
            ? "desc"
            : "asc";

    var nextStartTimeOrder =
        currentSortBy == "StartTime" && currentSortOrder == "asc"
            ? "desc"
            : "asc";

    var nextEndTimeOrder =
        currentSortBy == "EndTime" && currentSortOrder == "asc"
            ? "desc"
            : "asc";

    var nextPatientNameOrder =
        currentSortBy == "PatientName" && currentSortOrder == "asc"
            ? "desc"
            : "asc";

    var nextDoctorNameOrder =
        currentSortBy == "DoctorName" && currentSortOrder == "asc"
            ? "desc"
            : "asc";

    var nextAppointmentStatusOrder =
        currentSortBy == "AppointmentStatus" && currentSortOrder == "asc"
            ? "desc"
            : "asc";
}

<div class="page-container">

    <!-- Header -->
    <div class="header">

        <h2>Appointments</h2>

        <a asp-action="Create"
           class="btn-save"
           style="text-decoration: none;">
            + Add Appointment
        </a>

    </div>


    <!-- Search + Appointment Status Filter -->
    <form method="get">

        <div class="table-toolbar mb-3">

            <div class="search-box">

                <i class="bi bi-search"></i>

                <!-- Search -->
                <input type="text"
                       id="appointmentSearch"
                       name="searchString"
                       value="@currentSearch"
                       placeholder="Search appointments..."
                       autocomplete="off" />


                <!-- Appointment Status -->
                <select name="appointmentStatus"
                        id="appointmentStatus">

                    <option value=""
                            selected="@(string.IsNullOrEmpty(currentAppointmentStatus))">
                        All Appointment Status
                    </option>

                    <option value="Scheduled"
                            selected="@(currentAppointmentStatus == "Scheduled")">
                        Scheduled
                    </option>

                    <option value="Confirmed"
                            selected="@(currentAppointmentStatus == "Confirmed")">
                        Confirmed
                    </option>

                    <option value="Completed"
                            selected="@(currentAppointmentStatus == "Completed")">
                        Completed
                    </option>

                    <option value="Cancelled"
                            selected="@(currentAppointmentStatus == "Cancelled")">
                        Cancelled
                    </option>

                </select>


                <!-- Search Button -->
                <button type="submit"
                        class="btn btn-primary">
                    Search
                </button>


                <!-- Reset -->
                <a asp-action="Index"
                   class="btn-cancel">
                    Reset
                </a>

            </div>

        </div>

    </form>


    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert-success">
            @TempData["Success"]
        </div>
    }


    <!-- Appointments Table -->
    <div class="table-container">

        <table class="table">

            <thead>

                <tr>

                    <!-- Appointment Date -->
                    <th>
                        <a asp-action="Index"
                           asp-route-searchString="@currentSearch"
                           asp-route-appointmentStatus="@currentAppointmentStatus"
                           asp-route-sortBy="AppointmentDate"
                           asp-route-sortOrder="@nextAppointmentDateOrder">

                            Appointment Date

                            @if (currentSortBy == "AppointmentDate")
                            {
                                <span>
                                    @(currentSortOrder == "asc" ? "↑" : "↓")
                                </span>
                            }

                        </a>
                    </th>


                    <!-- Start Time -->
                    <th>
                        <a asp-action="Index"
                           asp-route-searchString="@currentSearch"
                           asp-route-appointmentStatus="@currentAppointmentStatus"
                           asp-route-sortBy="StartTime"
                           asp-route-sortOrder="@nextStartTimeOrder">

                            Start Time

                            @if (currentSortBy == "StartTime")
                            {
                                <span>
                                    @(currentSortOrder == "asc" ? "↑" : "↓")
                                </span>
                            }

                        </a>
                    </th>


                    <!-- End Time -->
                    <th>
                        <a asp-action="Index"
                           asp-route-searchString="@currentSearch"
                           asp-route-appointmentStatus="@currentAppointmentStatus"
                           asp-route-sortBy="EndTime"
                           asp-route-sortOrder="@nextEndTimeOrder">

                            End Time

                            @if (currentSortBy == "EndTime")
                            {
                                <span>
                                    @(currentSortOrder == "asc" ? "↑" : "↓")
                                </span>
                            }

                        </a>
                    </th>


                    <!-- Patient -->
                    <th>
                        <a asp-action="Index"
                           asp-route-searchString="@currentSearch"
                           asp-route-appointmentStatus="@currentAppointmentStatus"
                           asp-route-sortBy="PatientName"
                           asp-route-sortOrder="@nextPatientNameOrder">

                            Patient

                            @if (currentSortBy == "PatientName")
                            {
                                <span>
                                    @(currentSortOrder == "asc" ? "↑" : "↓")
                                </span>
                            }

                        </a>
                    </th>


                    <!-- Doctor -->
                    <th>
                        <a asp-action="Index"
                           asp-route-searchString="@currentSearch"
                           asp-route-appointmentStatus="@currentAppointmentStatus"
                           asp-route-sortBy="DoctorName"
                           asp-route-sortOrder="@nextDoctorNameOrder">

                            Doctor

                            @if (currentSortBy == "DoctorName")
                            {
                                <span>
                                    @(currentSortOrder == "asc" ? "↑" : "↓")
                                </span>
                            }

                        </a>
                    </th>


                    <!-- Appointment Status -->
                    <th>
                        <a asp-action="Index"
                           asp-route-searchString="@currentSearch"
                           asp-route-appointmentStatus="@currentAppointmentStatus"
                           asp-route-sortBy="AppointmentStatus"
                           asp-route-sortOrder="@nextAppointmentStatusOrder">

                            Appointment Status

                            @if (currentSortBy == "AppointmentStatus")
                            {
                                <span>
                                    @(currentSortOrder == "asc" ? "↑" : "↓")
                                </span>
                            }

                        </a>
                    </th>


                    <!-- Info -->
                    <th>
                        Info
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (Model.Items != null && Model.Items.Any())
                {
                    foreach (var appointment in Model.Items)
                    {
                        <tr>

                            <td>
                                @appointment.AppointmentDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @appointment.StartTime
                            </td>

                            <td>
                                @appointment.EndTime
                            </td>

                            <td>
                                @appointment.PatientName
                            </td>

                            <td>
                                @appointment.DoctorName
                            </td>

                            <td>
                                @appointment.Status
                            </td>

                            <td>

                                <a asp-action="Details"
                                   asp-route-id="@appointment.Id"
                                   class="btn-info">
                                    Details
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@appointment.Id"
                                   class="btn-edit">
                                    Edit
                                </a>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="7"
                            class="text-center">

                            No appointments found.

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>


    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="pagination">

            @if (Model.PageNumber > 1)
            {
                <a asp-action="Index"
                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                   asp-route-pageSize="@Model.PageSize"
                   asp-route-searchString="@currentSearch"
                   asp-route-appointmentStatus="@currentAppointmentStatus"
                   asp-route-sortBy="@currentSortBy"
                   asp-route-sortOrder="@currentSortOrder"
                   class="page-btn">

                    Prev

                </a>
            }


            <span class="page-info">

                Page @Model.PageNumber of @Model.TotalPages

            </span>


            @if (Model.PageNumber < Model.TotalPages)
            {
                <a asp-action="Index"
                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                   asp-route-pageSize="@Model.PageSize"
                   asp-route-searchString="@currentSearch"
                   asp-route-appointmentStatus="@currentAppointmentStatus"
                   asp-route-sortBy="@currentSortBy"
                   asp-route-sortOrder="@currentSortOrder"
                   class="page-btn">

                    Next

                </a>
            }

        </div>
    }

</div>