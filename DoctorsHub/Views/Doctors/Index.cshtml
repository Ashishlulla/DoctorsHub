@model PagedResult<DoctorDto>

@{
    ViewData["Title"] = "Doctors";

    var currentSearch = Context.Request.Query["searchString"].ToString();
    var currentSortBy = Context.Request.Query["sortBy"].ToString();
    var currentSortOrder = Context.Request.Query["sortOrder"].ToString();

    // Determine next sorting order for each column
    var nextNameOrder =
        currentSortBy == "FullName" && currentSortOrder == "asc"
            ? "desc"
            : "asc";

    var nextEmailOrder =
        currentSortBy == "Email" && currentSortOrder == "asc"
            ? "desc"
            : "asc";

    var nextQualificationOrder =
        currentSortBy == "Qualification" && currentSortOrder == "asc"
            ? "desc"
            : "asc";

    var nextExperienceOrder =
        currentSortBy == "ExperienceYears" && currentSortOrder == "asc"
            ? "desc"
            : "asc";

    var nextFeeOrder =
        currentSortBy == "ConsultationFee" && currentSortOrder == "asc"
            ? "desc"
            : "asc";

    var nextSpecializationOrder =
        currentSortBy == "Specialization" && currentSortOrder == "asc"
            ? "desc"
            : "asc";
}

<div class="page-container">

    <!-- Header -->
    <div class="header">

        <h2>Doctors</h2>

        <div class="actions">

            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create"
                   class="btn-save"
                   style="text-decoration: none;">
                    + Add Doctor
                </a>
            }

        </div>

    </div>


    <!-- Search -->
    <form method="get">

        <div class="table-toolbar mb-3">

            <div class="search-box">

                <i class="bi bi-search"></i>

                <input type="text"
                       id="doctorSearch"
                       name="searchString"
                       value="@currentSearch"
                       placeholder="Search doctors..."
                       autocomplete="off" />

                <button type="submit"
                        class="btn btn-primary">
                    Search
                </button>

                <a asp-action="Index"
                   class="btn-cancel">
                    Reset
                </a>

            </div>

        </div>

    </form>


    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert-success">
            @TempData["Success"]
        </div>
    }


    <!-- Doctors Table -->
    <div class="table-container">

        <table class="table">

            <thead>

                <tr>

                    <!-- Name -->
                    <th>
                        <a asp-action="Index"
                           asp-route-searchString="@currentSearch"
                           asp-route-sortBy="FullName"
                           asp-route-sortOrder="@nextNameOrder">

                            Name

                            @if (currentSortBy == "FullName")
                            {
                                <span>
                                    @(currentSortOrder == "asc" ? "↑" : "↓")
                                </span>
                            }

                        </a>
                    </th>


                    <!-- Email -->
                    <th>
                        <a asp-action="Index"
                           asp-route-searchString="@currentSearch"
                           asp-route-sortBy="Email"
                           asp-route-sortOrder="@nextEmailOrder">

                            Email

                            @if (currentSortBy == "Email")
                            {
                                <span>
                                    @(currentSortOrder == "asc" ? "↑" : "↓")
                                </span>
                            }

                        </a>
                    </th>


                    <!-- Qualification -->
                    <th>
                        <a asp-action="Index"
                           asp-route-searchString="@currentSearch"
                           asp-route-sortBy="Qualification"
                           asp-route-sortOrder="@nextQualificationOrder">

                            Qualification

                            @if (currentSortBy == "Qualification")
                            {
                                <span>
                                    @(currentSortOrder == "asc" ? "↑" : "↓")
                                </span>
                            }

                        </a>
                    </th>


                    <!-- Experience -->
                    <th>
                        <a asp-action="Index"
                           asp-route-searchString="@currentSearch"
                           asp-route-sortBy="ExperienceYears"
                           asp-route-sortOrder="@nextExperienceOrder">

                            Experience

                            @if (currentSortBy == "ExperienceYears")
                            {
                                <span>
                                    @(currentSortOrder == "asc" ? "↑" : "↓")
                                </span>
                            }

                        </a>
                    </th>


                    <!-- Consultation Fee -->
                    <th>
                        <a asp-action="Index"
                           asp-route-searchString="@currentSearch"
                           asp-route-sortBy="ConsultationFee"
                           asp-route-sortOrder="@nextFeeOrder">

                            Fee

                            @if (currentSortBy == "ConsultationFee")
                            {
                                <span>
                                    @(currentSortOrder == "asc" ? "↑" : "↓")
                                </span>
                            }

                        </a>
                    </th>


                    <!-- Specialization -->
                    <th>
                        <a asp-action="Index"
                           asp-route-searchString="@currentSearch"
                           asp-route-sortBy="Specialization"
                           asp-route-sortOrder="@nextSpecializationOrder">

                            Specialization

                            @if (currentSortBy == "Specialization")
                            {
                                <span>
                                    @(currentSortOrder == "asc" ? "↑" : "↓")
                                </span>
                            }

                        </a>
                    </th>


                    <!-- Details -->
                    <th>
                        Info
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (Model.Items != null && Model.Items.Any())
                {
                    foreach (var doctor in Model.Items)
                    {
                        <tr>

                            <td>
                                @doctor.FullName
                            </td>

                            <td>
                                @doctor.Email
                            </td>

                            <td>
                                @doctor.Qualification
                            </td>

                            <td>
                                @doctor.ExperienceYears Years
                            </td>

                            <td>
                                ₹@doctor.ConsultationFee.ToString("N2")
                            </td>

                            <td>
                                @doctor.SpecializationName
                            </td>

                            <td>

                                <a asp-controller="Doctors"
                                   asp-action="Details"
                                   asp-route-id="@doctor.Id"
                                   class="btn-info">
                                    Details
                                </a>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="7"
                            class="text-center">

                            No doctors found.

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>


    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="pagination">

            @if (Model.PageNumber > 1)
            {
                <a asp-action="Index"
                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                   asp-route-searchString="@currentSearch"
                   asp-route-sortBy="@currentSortBy"
                   asp-route-sortOrder="@currentSortOrder"
                   class="page-btn">

                    Prev

                </a>
            }


            <span class="page-info">

                Page @Model.PageNumber of @Model.TotalPages

            </span>


            @if (Model.PageNumber < Model.TotalPages)
            {
                <a asp-action="Index"
                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                   asp-route-searchString="@currentSearch"
                   asp-route-sortBy="@currentSortBy"
                   asp-route-sortOrder="@currentSortOrder"
                   class="page-btn">

                    Next

                </a>
            }

        </div>
    }

</div>
