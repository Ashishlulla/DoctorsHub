@model DoctorsHub.Application.DTOs.Departments.DepartmentDetailsDto

@{
    ViewData["Title"] = Model.Name;
}

<div class="page-header">

    <div>

        <a asp-action="Index"
           class="btn btn-cancel mb-3">

            <i class="bi bi-arrow-left"></i>
            Back to Departments

        </a>

        <h1 class="page-title mb-2">
            @Model.Name
        </h1>

        <p class="page-subtitle mb-0">
            @(string.IsNullOrWhiteSpace(Model.Description)
                ? "Doctors assigned to this department"
                : Model.Description)
        </p>

    </div>

</div>


<div class="content-card mt-4">

    <!-- ================= TABLE TOOLBAR ================= -->

    <div class="table-toolbar mb-3">

        <div class="search-box">

            <i class="bi bi-search"></i>

            <input type="text"
                   id="doctorSearch"
                   placeholder="Search doctors..." />

            <button type="button"
                    id="searchDoctorButton"
                    class="btn btn-primary">

                Search

            </button>

        </div>

    </div>


    <!-- ================= DOCTORS TABLE ================= -->

    <div class="card-body">

        <div class="table-container">

            <table class="table">

                <thead>

                    <tr>

                        <th>Sr.no</th>
                        <th>Doctor</th>
                        <th>Specialization</th>
                        <th>Qualification</th>
                        <th>Experience</th>
                        <th>Email</th>
                        <th>Consultation Fee</th>
                        <th class="text-end">Info</th>

                    </tr>

                </thead>


                <tbody id="doctorTableBody">

                    @if (Model.Doctors != null && Model.Doctors.Any())
                    {

                        int sr = 1;

                        foreach (var doctor in Model.Doctors)
                        {

                            <tr>

                                <td>
                                    @sr
                                </td>

                                <td>
                                    @doctor.FullName
                                </td>

                                <td>
                                    @doctor.SpecializationName
                                </td>

                                <td>
                                    @doctor.Qualification
                                </td>

                                <td>
                                    @doctor.ExperienceYears Years
                                </td>

                                <td>
                                    @doctor.Email
                                </td>

                                <td>
                                    ₹ @doctor.ConsultationFee.ToString("N2")
                                </td>

                                <td>
                                    <a asp-action="Details"
                                       asp-route-id="@doctor.Id"
                                       class="btn-info">
                                        Details
                                    </a>
                                </td>

                            </tr>

                            sr++;

                        }

                    }
                    else
                    {

                        <tr>

                            <td colspan="8"
                                class="text-center">

                                No doctors found.

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<script src="~/js/department-details.js"></script>