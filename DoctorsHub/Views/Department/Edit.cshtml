@model DoctorsHub.Application.DTOs.Departments.UpdateDepartmentDto

@{
    ViewData["Title"] = "Edit Department";
}

<div class="page-container">

    <!-- Header -->
    <div class="header">
        <div>
            <h2>Edit Department</h2>
            <p class="text-muted mb-0">
                Update department information.
            </p>
        </div>

        <div class="actions">
            <a asp-action="Index" class="btn-cancel">
                <i class="bi bi-arrow-left"></i>
                Back
            </a>
        </div>
    </div>

    <!-- Form -->
    <div class="form-card">

        <form asp-action="Edit" method="post">

            <input asp-for="Id" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <!-- Department Information -->
            <div class="form-section">

                <h3>Department Information</h3>
                <hr />

                <div class="form-group">

                    <div>
                        <label asp-for="Name" class="form-label">
                            Department Name
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="e.g. Cardiology" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>
                    </div>

                </div>

                <div class="mt-3">

                    <label asp-for="Description" class="form-label">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="5"
                              placeholder="Enter a short description for this department..."></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>

            </div>

            <!-- Actions -->
            <div class="actions justify-content-end">

                <a asp-action="Index"
                   class="btn-cancel">
                    Cancel
                </a>

                <button type="submit"
                        class="btn-save">

                    <i class="bi bi-check-lg"></i>
                    Save Changes

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}