```cshtml
@model PagedResult<PatientDto>

@{
    ViewData["Title"] = "Patients";

    var currentSearch = Context.Request.Query["searchString"].ToString();
    var currentSortBy = Context.Request.Query["sortBy"].ToString();
    var currentSortOrder = Context.Request.Query["sortOrder"].ToString();

    // Determine next sorting order for each column
    var nextNameOrder =
        currentSortBy == "FullName" && currentSortOrder == "asc"
            ? "desc"
            : "asc";

    var nextEmailOrder =
        currentSortBy == "Email" && currentSortOrder == "asc"
            ? "desc"
            : "asc";

    var nextPhoneOrder =
        currentSortBy == "PhoneNumber" && currentSortOrder == "asc"
            ? "desc"
            : "asc";

    var nextDateOfBirthOrder =
        currentSortBy == "DateOfBirth" && currentSortOrder == "asc"
            ? "desc"
            : "asc";

    var nextGenderOrder =
        currentSortBy == "Gender" && currentSortOrder == "asc"
            ? "desc"
            : "asc";

    var nextBloodGroupOrder =
        currentSortBy == "BloodGroup" && currentSortOrder == "asc"
            ? "desc"
            : "asc";
}

<div class="page-container">

    <!-- Header -->
    <div class="header">

        <h2>Patients</h2>

        <div class="actions">

            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create"
                   class="btn-save"
                   style="text-decoration: none;">
                    + Add Patient
                </a>
            }

        </div>

    </div>


    <!-- Search -->
    <form method="get">

        <div class="table-toolbar mb-3">

            <div class="search-box">

                <i class="bi bi-search"></i>

                <input type="text"
                       id="patientSearch"
                       name="searchString"
                       value="@currentSearch"
                       placeholder="Search patients..."
                       autocomplete="off" />

                <button type="submit"
                        class="btn btn-primary">
                    Search
                </button>

                <a asp-action="Index"
                   class="btn-cancel">
                    Reset
                </a>

            </div>

        </div>

    </form>


    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert-success">
            @TempData["Success"]
        </div>
    }


    <!-- Patients Table -->
    <div class="table-container">

        <table class="table">

            <thead>

                <tr>

                    <!-- Name -->
                    <th>
                        <a asp-action="Index"
                           asp-route-searchString="@currentSearch"
                           asp-route-sortBy="FullName"
                           asp-route-sortOrder="@nextNameOrder">

                            Name

                            @if (currentSortBy == "FullName")
                            {
                                <span>
                                    @(currentSortOrder == "asc" ? "↑" : "↓")
                                </span>
                            }

                        </a>
                    </th>


                    <!-- Email -->
                    <th>
                        <a asp-action="Index"
                           asp-route-searchString="@currentSearch"
                           asp-route-sortBy="Email"
                           asp-route-sortOrder="@nextEmailOrder">

                            Email

                            @if (currentSortBy == "Email")
                            {
                                <span>
                                    @(currentSortOrder == "asc" ? "↑" : "↓")
                                </span>
                            }

                        </a>
                    </th>


                    <!-- Phone -->
                    <th>
                        <a asp-action="Index"
                           asp-route-searchString="@currentSearch"
                           asp-route-sortBy="PhoneNumber"
                           asp-route-sortOrder="@nextPhoneOrder">

                            Phone Number

                            @if (currentSortBy == "PhoneNumber")
                            {
                                <span>
                                    @(currentSortOrder == "asc" ? "↑" : "↓")
                                </span>
                            }

                        </a>
                    </th>


                    <!-- Date of Birth -->
                    <th>
                        <a asp-action="Index"
                           asp-route-searchString="@currentSearch"
                           asp-route-sortBy="DateOfBirth"
                           asp-route-sortOrder="@nextDateOfBirthOrder">

                            Date of Birth

                            @if (currentSortBy == "DateOfBirth")
                            {
                                <span>
                                    @(currentSortOrder == "asc" ? "↑" : "↓")
                                </span>
                            }

                        </a>
                    </th>


                    <!-- Gender -->
                    <th>
                        <a asp-action="Index"
                           asp-route-searchString="@currentSearch"
                           asp-route-sortBy="Gender"
                           asp-route-sortOrder="@nextGenderOrder">

                            Gender

                            @if (currentSortBy == "Gender")
                            {
                                <span>
                                    @(currentSortOrder == "asc" ? "↑" : "↓")
                                </span>
                            }

                        </a>
                    </th>


                    <!-- Blood Group -->
                    <th>
                        <a asp-action="Index"
                           asp-route-searchString="@currentSearch"
                           asp-route-sortBy="BloodGroup"
                           asp-route-sortOrder="@nextBloodGroupOrder">

                            Blood Group

                            @if (currentSortBy == "BloodGroup")
                            {
                                <span>
                                    @(currentSortOrder == "asc" ? "↑" : "↓")
                                </span>
                            }

                        </a>
                    </th>


                    <!-- Details -->
                    <th>
                        Info
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (Model.Items != null && Model.Items.Any())
                {
                    foreach (var patient in Model.Items)
                    {
                        <tr>

                            <td>
                                @patient.FullName
                            </td>

                            <td>
                                @patient.Email
                            </td>

                            <td>
                                @patient.PhoneNumber
                            </td>

                            <td>
                                @patient.DateOfBirth.ToString("dd-MMM-yyyy")
                            </td>

                            <td>
                                @patient.Gender
                            </td>

                            <td>
                                @patient.BloodGroup
                            </td>

                            <td>

                                <a asp-controller="Patient"
                                   asp-action="Details"
                                   asp-route-id="@patient.Id"
                                   class="btn-info">
                                    Details
                                </a>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="7"
                            class="text-center">

                            No patients found.

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>


    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="pagination">

            @if (Model.PageNumber > 1)
            {
                <a asp-action="Index"
                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                   asp-route-searchString="@currentSearch"
                   asp-route-sortBy="@currentSortBy"
                   asp-route-sortOrder="@currentSortOrder"
                   class="page-btn">

                    Prev

                </a>
            }


            <span class="page-info">

                Page @Model.PageNumber of @Model.TotalPages

            </span>


            @if (Model.PageNumber < Model.TotalPages)
            {
                <a asp-action="Index"
                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                   asp-route-searchString="@currentSearch"
                   asp-route-sortBy="@currentSortBy"
                   asp-route-sortOrder="@currentSortOrder"
                   class="page-btn">

                    Next

                </a>
            }

        </div>
    }

</div>
```
